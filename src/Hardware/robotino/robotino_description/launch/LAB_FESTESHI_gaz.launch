<!-- robotino_xarm_spawn.launch -->
<launch>
  <!-- 1. Use simulated clock (Gazebo) -->
  <param name="use_sim_time" value="true"/>
  <param name="robot_description" command="$(find xacro)/xacro $(find robotino_description)/urdf/robotino_armful.urdf.xacro" />
  <node name="robot_state_publisher" pkg="robot_state_publisher"
        type="robot_state_publisher" output="screen"/>
<node pkg="tf2_ros" type="static_transform_publisher" name="camera_optical_tf" args="0 0 0 0 0 0 camera_link camera_depth_optical_frame" />


        
  <arg name="world_name" value="$(find tmc_wrs_gazebo_worlds)/worlds/bio_robotics_lab2.world"/>
  <!-- Robot Pose Parameters -->
  <arg name="x" default="0.0"/>
  <arg name="y" default="0.0"/>
  <arg name="z" default="0.1"/>
  <arg name="yaw" default="0.0"/>
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="world_name" value="$(arg world_name)" />
    <arg name="gui" value="true"/>
  </include>
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_xarm_robotino"
        args="-urdf -model festeshi -param robot_description -x 0 -y 0 -z 0.06
              -J joint1 0 -J joint2 0 -J joint3 0 -J joint4 0 -J joint5 0"
        output="screen"/>

<rosparam file="$(find xarm_controller)/config/xarm5/xarm5_controllers.yaml" command="load" ns="/xarm" />

<node name="xarm5_traj_controller_spawner" pkg="controller_manager" type="spawner" respawn="false"
      output="screen" args="xarm5_traj_controller --namespace /xarm" />
<!-- Spawn joint_state_controller -->
<node name="joint_state_controller_spawner" pkg="controller_manager" type="spawner" respawn="false"
      output="screen" args="joint_state_controller --namespace /xarm" />
</launch>
