<?xml version="1.0"?>
<robot name="festeshi" xmlns:xacro="http://ros.org/wiki/xacro">
<gazebo>
  <static>false</static>
</gazebo>

  <!-- ARGUMENTS -->
  <xacro:arg name="add_gripper" default="false"/>
  <xacro:arg name="add_vacuum_gripper" default="false"/>
  <xacro:arg name="effort_control" default="true"/>
  <xacro:arg name="xarm_velocity_control" default="false"/>
  <xacro:arg name="model1300" default="false"/>
  <xacro:arg name="add_realsense_d435i" default="false"/>
  <xacro:arg name="add_d435i_links" default="false"/>
  <xacro:arg name="robot_sn" default=""/>
  <xacro:arg name="namespace" default="xarm"/>
  <xacro:arg name="attach_to" default="platform_link"/>
  <xacro:arg name="prefix" default="" />
  <xacro:property name="kinect_mesh" value="package://robotino_description/meshes/sensors/kinect.dae"/>


  <!-- INCLUDE base first, which is a full robot -->
  <xacro:include filename="$(find robotino_description)/urdf/robotino_armless.urdf.xacro"/>

<xacro:include filename="$(find xarm_description)/urdf/xarm_device_macro.xacro"/>



  <!-- Instantiate xarm_device manually with control -->
  <xacro:xarm_device
    robot_type="xarm"
    dof="5"
    prefix="$(arg prefix)"
    add_gripper="$(arg add_gripper)"
    add_vacuum_gripper="$(arg add_vacuum_gripper)"
    effort_control="false"
    velocity_control="false"
    model1300="$(arg model1300)"
    add_realsense_d435i="$(arg add_realsense_d435i)"
    add_d435i_links="$(arg add_d435i_links)"
    robot_sn="$(arg robot_sn)"
    hw_ns="$(arg namespace)"
    attach_to="$(arg attach_to)"
    create_attach_link="false" />

<!-- === Kinect mounted on link5 === -->

<!-- Fixed joint that attaches the Kinect to the arm -->
<joint name="camera_joint" type="fixed">
  <parent link="link5"/>
  <child  link="camera_link"/>
  <!-- tweak xyz/rpy to match the real mounting position -->
  <origin xyz="0.0 0 0.0" rpy="0 0 0"/>
</joint>

<!-- Kinect link body -->
<link name="camera_link">
  <visual>
  <origin xyz="0.08 0.0 -0.04" rpy="-1.57 0 -1.57"/>
    <geometry>
      <mesh filename="${kinect_mesh}" scale="1 1 1"/>
    </geometry>
  </visual>
  <collision>
  <origin xyz="0.08 0.0 -0.04" rpy="-1.57 0 -1.57"/>
    <geometry>
      <mesh filename="${kinect_mesh}" scale="1 1 1"/>
    </geometry>
  </collision>
</link>

<!-- Gazebo depth-camera sensor plugin -->
<gazebo reference="camera_link">
 <sensor type="depth" name="kinect_sensor">


<pose>0 0 0 -1.5708 -1.5708 -1.5708</pose>

  <always_on>true</always_on>
  <update_rate>30</update_rate>
  <visualize>true</visualize>

  <camera>
    <horizontal_fov>1.0472</horizontal_fov> <!-- 60 deg -->
    <image>
      <width>640</width>
      <height>480</height>
      <format>R8G8B8</format>
    </image>
    <depth_near>0.1</depth_near>
    <depth_far>10.0</depth_far>
  </camera>

  <plugin name="kinect_controller" filename="libgazebo_ros_openni_kinect.so">
    <alwaysOn>true</alwaysOn>
    <updateRate>30.0</updateRate>
    <cameraName>camera</cameraName>

    <imageTopicName>rgb/image_raw</imageTopicName>
    <depthImageTopicName>depth/image_raw</depthImageTopicName>
    <depthImageCameraInfoTopicName>depth/camera_info</depthImageCameraInfoTopicName>
    <pointCloudTopicName>depth_registered/points</pointCloudTopicName>

    <frameName>camera_link</frameName>
    <hackBaseline>0.07</hackBaseline>

    <depthImageFormat>16UC1</depthImageFormat>
    <imageFormat>R8G8B8</imageFormat>

    <distortionK1>0.0</distortionK1>
    <distortionK2>0.0</distortionK2>
    <distortionK3>0.0</distortionK3>
    <distortionT1>0.0</distortionT1>
    <distortionT2>0.0</distortionT2>
  </plugin>
</sensor>
</gazebo>
<!-- === End Kinect block === -->


</robot>